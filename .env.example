# Modèle des variables d'environnement de l'application Next.js.
# Copier en .env.development.local (local) ; en production, les saisir dans Vercel.
# Une valeur seule par ligne : sans guillemets, sans espace, sans virgule finale.
# Ne jamais mettre un secret dans une variable NEXT_PUBLIC_ (elles sont envoyées au navigateur).

# --- Supabase ---
# URL de base du projet (sans /rest/v1/ à la fin).
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
# Clé publique (publishable) : sûre côté navigateur, les RLS protègent les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service role) : serveur seulement (création des comptes, admin). Secrète.
SUPABASE_SECRET_KEY=

# --- Firebase (push dans le navigateur) : configuration publique de l'app web ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Clé VAPID publique (Firebase > Cloud Messaging > certificats Web push).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Hors Next : secrets de l'Edge Function envoyer-notification ---
# Ils ne vont PAS dans ce fichier ni dans Vercel, mais dans Supabase :
#   supabase secrets set NOM=valeur
# APP_URL                        adresse de l'application (liens des mails et push)
# RESEND_API_KEY                 clé d'API Resend
# RESEND_TEST_RECIPIENT          mode test : adresse du compte Resend qui reçoit tous les mails
#                                (à retirer quand le domaine d'envoi est vérifié)
# RESEND_FROM                    expéditeur, une fois le domaine vérifié
# FIREBASE_SERVICE_ACCOUNT_KEY   compte de service Firebase : contenu du JSON encodé en base64
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.
